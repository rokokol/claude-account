#!/usr/bin/env bash
# Stands in for the real pgrep, so the suite does not depend on whether a claude session
# happens to be open on the machine running it — including the one running the suite
set -euo pipefail

if [[ "$*" == *opencode* ]]; then
  [[ -n "${FAKE_OPENCODE_RUNNING:-}" ]] && exit 0
else
  [[ -n "${FAKE_CLAUDE_RUNNING:-}" ]] && exit 0
fi
exit 1
